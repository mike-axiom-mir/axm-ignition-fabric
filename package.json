{
  "name": "axm-ignition-fabric",
  "version": "0.0.23",
  "private": true,
  "type": "module",
  "description": "Deterministic bounded capability materialization and state-bound session runtime.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mike-axiom-mir/axm-ignition-fabric.git"
  },
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "axm-ignition": "./scripts/package-cli.mjs"
  },
  "files": [
    "src",
    "scripts/package-cli.mjs",
    "scripts/run-demo.mjs",
    "CONSUMER.md",
    "LICENSE"
  ],
  "axmCapability": {
    "schema": "axm.capability/v1",
    "id": "axm.ignition.materialization-core",
    "version": "0.6.0",
    "status": "EXPERIMENTAL",
    "runtime": {
      "kind": "node",
      "minimumVersion": "18",
      "networkRequired": false,
      "dependencies": []
    },
    "entrypoints": {
      "library": ".",
      "command": "axm-ignition",
      "discoveryCommand": "axm-ignition describe",
      "demoCommand": "axm-ignition demo"
    },
    "contracts": {
      "runReceipt": "axm.ignition-run/v0.05",
      "sessionReceipt": "axm.ignition-session-run/v0.06",
      "transitionReceipt": "axm.ignition-transition/v0.06"
    },
    "authority": {
      "canonical": false,
      "automaticMerge": false
    }
  },
  "scripts": {
    "test": "node --test",
    "demo": "node scripts/run-demo.mjs",
    "benchmark:memory": "node scripts/run-memory-benchmark.mjs",
    "benchmark:realistic": "node scripts/run-realistic-benchmark.mjs",
    "benchmark:warm": "node scripts/run-warm-benchmark.mjs",
    "benchmark:governor": "node scripts/run-governor-benchmark.mjs",
    "benchmark:invalidation": "node scripts/run-scoped-invalidation-benchmark.mjs",
    "benchmark:retention": "node scripts/run-retention-benchmark.mjs",
    "benchmark:truth-budget": "node scripts/run-truth-budget-benchmark.mjs",
    "benchmark:domain-identity": "node scripts/run-domain-identity-benchmark.mjs",
    "benchmark:incremental-identity": "node scripts/run-incremental-identity-benchmark.mjs",
    "benchmark:workset": "node scripts/run-workset-benchmark.mjs",
    "benchmark:streamed-peak": "node scripts/run-streamed-peak-benchmark.mjs",
    "benchmark:segmented-search": "node scripts/run-segmented-search-benchmark.mjs",
    "benchmark:construction-lifetime": "node scripts/run-construction-lifetime-benchmark.mjs",
    "benchmark:residual-attribution": "node scripts/run-residual-attribution-benchmark.mjs",
    "benchmark:streaming-fingerprint": "node scripts/run-streaming-fingerprint-benchmark.mjs",
    "benchmark:adaptive-fingerprint": "node scripts/run-adaptive-fingerprint-benchmark.mjs",
    "benchmark:shared-traversal-fingerprint": "node scripts/run-shared-traversal-fingerprint-benchmark.mjs",
    "benchmark:canonical-size-hint": "node scripts/run-canonical-size-hint-benchmark.mjs",
    "benchmark:one-truth-advance": "node scripts/run-one-truth-advance-benchmark.mjs",
    "benchmark:domain-checkpoints": "node scripts/run-domain-checkpoint-benchmark.mjs",
    "benchmark:adaptive-truth-checkpoints": "node scripts/run-adaptive-truth-checkpoint-benchmark.mjs"
  }
}
